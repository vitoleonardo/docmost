{
  "version": 1,
  "headers": {
    "serviceTokenHeader": "X-Service-Token",
    "userTokenHeader": "X-User-Token"
  },
  "errorBody": ["code", "message"],
  "errors": {
    "assistant_disabled": 503,
    "assistant_unavailable": 503,
    "service_token_missing": 401,
    "service_token_invalid": 401,
    "user_token_missing": 401,
    "user_token_expired": 401,
    "user_token_invalid": 401,
    "user_id_not_allowed": 400,
    "invalid_request": 400,
    "too_many_page_ids": 400,
    "page_not_found": 404,
    "space_not_found": 404,
    "attachment_not_found": 404,
    "proposal_not_found": 404,
    "proposal_not_open": 409,
    "run_in_progress": 409,
    "page_not_editable": 403
  },
  "endpoints": [
    {
      "side": "wiki-client",
      "method": "POST",
      "path": "/api/ai/status",
      "auth": ["session"],
      "request": [],
      "response": ["status"],
      "values": {
        "status": ["available", "unavailable", "disabled"]
      },
      "status": 200,
      "errors": []
    },
    {
      "side": "wiki-client",
      "method": "POST",
      "path": "/api/ai/ask",
      "auth": ["session"],
      "request": ["question", "conversationId", "spaceId", "pageId"],
      "response": [],
      "responseType": "sse",
      "responseContentType": "text/event-stream",
      "events": {
        "delta": ["type", "text"],
        "sources": [
          "type",
          "sources[].number",
          "sources[].pageId",
          "sources[].title",
          "sources[].spaceName",
          "sources[].headingPath",
          "sources[].fileName",
          "sources[].pdfPage",
          "sources[].url"
        ],
        "no_source": ["type"],
        "error": ["type", "code"]
      },
      "values": {
        "errorCode": ["model_unavailable"]
      },
      "maxQuestionLength": 2000,
      "status": 200,
      "errors": [
        "assistant_disabled",
        "assistant_unavailable",
        "invalid_request",
        "space_not_found",
        "page_not_found"
      ]
    },
    {
      "side": "wiki-client",
      "method": "POST",
      "path": "/api/ai/extract",
      "auth": ["session"],
      "request": ["pageId", "attachmentId"],
      "response": [],
      "outcomes": {
        "extracted": [
          "outcome",
          "fields[].key",
          "fields[].value",
          "fields[].quote",
          "fields[].pdfPage"
        ],
        "refused": [
          "outcome",
          "reason",
          "pageCount",
          "fileSize",
          "characterCount"
        ],
        "failed": ["outcome", "reason"]
      },
      "values": {
        "outcome": ["extracted", "refused", "failed"],
        "fieldKey": ["parties", "term", "noticePeriod", "value", "renewal"],
        "refusedReason": [
          "no_text_layer",
          "too_many_pages",
          "too_large",
          "too_much_text",
          "unreadable"
        ],
        "failedReason": ["model_unavailable"]
      },
      "status": 200,
      "errors": [
        "invalid_request",
        "page_not_editable",
        "page_not_found",
        "attachment_not_found",
        "assistant_disabled",
        "assistant_unavailable"
      ]
    },
    {
      "side": "bridge",
      "method": "POST",
      "path": "/api/ai-bridge/internal/filter-pages",
      "changesPageContent": false,
      "auth": ["service", "user"],
      "acceptsTaskToken": true,
      "request": ["pageIds", "spaceId"],
      "response": ["pageIds"],
      "status": 200,
      "errors": [
        "assistant_disabled",
        "service_token_missing",
        "service_token_invalid",
        "user_token_missing",
        "user_token_expired",
        "user_token_invalid",
        "user_id_not_allowed",
        "invalid_request",
        "too_many_page_ids"
      ]
    },
    {
      "side": "bridge",
      "method": "POST",
      "path": "/api/ai-bridge/internal/task-token",
      "changesPageContent": false,
      "auth": ["service", "user"],
      "acceptsTaskToken": false,
      "request": ["runId"],
      "response": ["taskToken", "expiresAt"],
      "status": 200,
      "errors": [
        "assistant_disabled",
        "service_token_missing",
        "service_token_invalid",
        "user_token_missing",
        "user_token_expired",
        "user_token_invalid",
        "user_id_not_allowed",
        "invalid_request"
      ]
    },
    {
      "side": "bridge",
      "method": "POST",
      "path": "/api/ai-bridge/internal/pages",
      "changesPageContent": false,
      "auth": ["service"],
      "request": ["cursor"],
      "response": [
        "pages[].id",
        "pages[].spaceId",
        "pages[].updatedAt",
        "nextCursor"
      ],
      "maxPageSize": 500,
      "status": 200,
      "errors": [
        "assistant_disabled",
        "service_token_missing",
        "service_token_invalid",
        "user_id_not_allowed",
        "invalid_request"
      ]
    },
    {
      "side": "bridge",
      "method": "POST",
      "path": "/api/ai-bridge/internal/page-content",
      "changesPageContent": false,
      "auth": ["service"],
      "request": ["pageId"],
      "response": [
        "id",
        "title",
        "spaceId",
        "workspaceId",
        "updatedAt",
        "markdown",
        "attachments[].id",
        "attachments[].fileName",
        "attachments[].mimeType",
        "attachments[].fileSize"
      ],
      "status": 200,
      "errors": [
        "assistant_disabled",
        "service_token_missing",
        "service_token_invalid",
        "user_id_not_allowed",
        "invalid_request",
        "page_not_found"
      ]
    },
    {
      "side": "bridge",
      "method": "POST",
      "path": "/api/ai-bridge/internal/attachment",
      "changesPageContent": false,
      "auth": ["service"],
      "request": ["attachmentId"],
      "response": [],
      "responseType": "binary",
      "responseContentType": "mimeType of the attachment",
      "status": 200,
      "errors": [
        "assistant_disabled",
        "service_token_missing",
        "service_token_invalid",
        "user_id_not_allowed",
        "invalid_request",
        "attachment_not_found"
      ]
    },
    {
      "side": "bridge",
      "method": "POST",
      "path": "/api/ai-bridge/internal/tools/read-page",
      "changesPageContent": false,
      "auth": ["service", "user"],
      "acceptsTaskToken": true,
      "request": ["pageId"],
      "response": ["id", "title", "spaceId", "markdown"],
      "status": 200,
      "errors": [
        "assistant_disabled",
        "service_token_missing",
        "service_token_invalid",
        "user_token_missing",
        "user_token_expired",
        "user_token_invalid",
        "user_id_not_allowed",
        "invalid_request",
        "page_not_found"
      ]
    },
    {
      "side": "bridge",
      "method": "POST",
      "path": "/api/ai-bridge/internal/tools/search",
      "changesPageContent": false,
      "auth": ["service", "user"],
      "acceptsTaskToken": true,
      "request": ["spaceId", "query"],
      "response": ["results[].id", "results[].title", "results[].spaceId"],
      "maxResults": 20,
      "status": 200,
      "errors": [
        "assistant_disabled",
        "service_token_missing",
        "service_token_invalid",
        "user_token_missing",
        "user_token_expired",
        "user_token_invalid",
        "user_id_not_allowed",
        "invalid_request",
        "space_not_found"
      ]
    },
    {
      "side": "bridge",
      "method": "POST",
      "path": "/api/ai-bridge/internal/tools/read-blocks",
      "changesPageContent": false,
      "auth": ["service", "user"],
      "acceptsTaskToken": true,
      "request": ["pageId", "spaceId"],
      "response": [
        "id",
        "title",
        "spaceId",
        "fingerprint",
        "blocks[].number",
        "blocks[].text",
        "blocks[].heading",
        "blocks[].isHeading",
        "blocks[].editable"
      ],
      "status": 200,
      "errors": [
        "assistant_disabled",
        "assistant_unavailable",
        "service_token_missing",
        "service_token_invalid",
        "user_token_missing",
        "user_token_expired",
        "user_token_invalid",
        "user_id_not_allowed",
        "invalid_request",
        "page_not_found"
      ]
    },
    {
      "side": "ai-service",
      "method": "POST",
      "path": "/v1/session",
      "auth": ["service", "user"],
      "request": [],
      "response": ["userId", "workspaceId"],
      "status": 200,
      "errors": [
        "service_token_missing",
        "service_token_invalid",
        "user_token_missing",
        "user_token_expired",
        "user_token_invalid"
      ]
    },
    {
      "side": "ai-service",
      "method": "POST",
      "path": "/v1/ask",
      "auth": ["service", "user"],
      "request": ["question", "conversationId", "spaceId", "pageId"],
      "response": [],
      "responseType": "ndjson",
      "responseContentType": "application/x-ndjson",
      "events": {
        "delta": ["type", "text"],
        "citations": [
          "type",
          "turnId",
          "citations[].number",
          "citations[].pageId",
          "citations[].headingPath",
          "citations[].attachmentId",
          "citations[].fileName",
          "citations[].pdfPage"
        ],
        "no_source": ["type"],
        "error": ["type", "code"]
      },
      "values": {
        "errorCode": ["model_unavailable"]
      },
      "maxQuestionLength": 2000,
      "status": 200,
      "errors": [
        "service_token_missing",
        "service_token_invalid",
        "user_token_missing",
        "user_token_expired",
        "user_token_invalid",
        "invalid_request"
      ]
    },
    {
      "side": "ai-service",
      "method": "POST",
      "path": "/v1/extract",
      "auth": ["service", "user"],
      "request": ["attachmentId", "fileSize"],
      "response": [],
      "outcomes": {
        "extracted": [
          "outcome",
          "fields[].key",
          "fields[].value",
          "fields[].quote",
          "fields[].pdfPage"
        ],
        "refused": [
          "outcome",
          "reason",
          "pageCount",
          "fileSize",
          "characterCount"
        ],
        "failed": ["outcome", "reason"]
      },
      "values": {
        "outcome": ["extracted", "refused", "failed"],
        "fieldKey": ["parties", "term", "noticePeriod", "value", "renewal"],
        "refusedReason": [
          "no_text_layer",
          "too_many_pages",
          "too_large",
          "too_much_text",
          "unreadable"
        ],
        "failedReason": ["model_unavailable"]
      },
      "status": 200,
      "errors": [
        "service_token_missing",
        "service_token_invalid",
        "user_token_missing",
        "user_token_expired",
        "user_token_invalid",
        "invalid_request",
        "attachment_not_found",
        "assistant_unavailable"
      ]
    },
    {
      "side": "ai-service",
      "method": "POST",
      "path": "/v1/agent/runs",
      "auth": ["service", "user"],
      "request": ["spaceId", "task"],
      "response": [],
      "responseType": "ndjson",
      "responseContentType": "application/x-ndjson",
      "events": {
        "run": ["type", "runId"],
        "step": [
          "type",
          "steps",
          "label.kind",
          "label.query",
          "label.count",
          "label.title"
        ],
        "proposal": [
          "type",
          "proposal.id",
          "proposal.pageId",
          "proposal.pageTitle",
          "proposal.reason",
          "proposal.added",
          "proposal.removed"
        ],
        "end": ["type", "outcome", "pagesRead", "message"]
      },
      "values": {
        "stepKind": ["search", "read", "propose", "refused"],
        "endOutcome": [
          "finished",
          "out_of_scope",
          "step_limit",
          "time_limit",
          "token_limit",
          "context_too_small",
          "model_failed"
        ]
      },
      "maxTaskLength": 2000,
      "status": 200,
      "errors": [
        "service_token_missing",
        "service_token_invalid",
        "user_token_missing",
        "user_token_expired",
        "user_token_invalid",
        "invalid_request",
        "run_in_progress",
        "assistant_unavailable"
      ]
    },
    {
      "side": "ai-service",
      "method": "POST",
      "path": "/v1/agent/proposals/get",
      "auth": ["service", "user"],
      "request": ["proposalId"],
      "response": [
        "id",
        "runId",
        "userId",
        "pageId",
        "pageTitle",
        "spaceId",
        "reason",
        "fingerprint",
        "changes",
        "added",
        "removed",
        "status",
        "appliedBy",
        "appliedAt"
      ],
      "values": {
        "status": ["open", "applying", "applied", "discarded", "stale"]
      },
      "status": 200,
      "errors": [
        "service_token_missing",
        "service_token_invalid",
        "user_token_missing",
        "user_token_expired",
        "user_token_invalid",
        "invalid_request",
        "proposal_not_found"
      ]
    },
    {
      "side": "ai-service",
      "method": "POST",
      "path": "/v1/agent/proposals/transition",
      "auth": ["service", "user"],
      "request": ["proposalId", "to"],
      "response": [
        "id",
        "runId",
        "userId",
        "pageId",
        "pageTitle",
        "spaceId",
        "reason",
        "fingerprint",
        "changes",
        "added",
        "removed",
        "status",
        "appliedBy",
        "appliedAt"
      ],
      "values": {
        "to": ["applying", "applied", "open", "stale", "discarded"]
      },
      "status": 200,
      "errors": [
        "service_token_missing",
        "service_token_invalid",
        "user_token_missing",
        "user_token_expired",
        "user_token_invalid",
        "invalid_request",
        "proposal_not_found",
        "proposal_not_open"
      ]
    },
    {
      "side": "ai-service",
      "method": "POST",
      "path": "/v1/conversations/confirm",
      "auth": ["service", "user"],
      "request": ["conversationId", "turnId"],
      "response": [],
      "status": 204,
      "errors": [
        "service_token_missing",
        "service_token_invalid",
        "user_token_missing",
        "user_token_expired",
        "user_token_invalid",
        "invalid_request"
      ]
    },
    {
      "side": "ai-service",
      "method": "POST",
      "path": "/v1/jobs",
      "auth": ["service"],
      "request": ["name", "data"],
      "response": ["id"],
      "status": 202,
      "errors": [
        "service_token_missing",
        "service_token_invalid",
        "invalid_request"
      ]
    }
  ],
  "tokens": {
    "algorithm": "HS256",
    "user": {
      "claims": ["sub", "workspaceId", "spaceIds", "aud", "type", "iat", "exp"],
      "aud": "ai-service",
      "type": "user",
      "maxLifetimeSeconds": 60
    },
    "task": {
      "claims": ["sub", "workspaceId", "runId", "aud", "type", "iat", "exp"],
      "aud": "ai-service",
      "type": "task",
      "maxLifetimeSeconds": 900
    }
  },
  "jobs": {
    "stream": "ai-service:jobs",
    "body": ["name", "data"],
    "forwarded": {
      "page-created": ["pageIds", "workspaceId"],
      "page-content-updated": ["pageIds", "workspaceId"],
      "page-soft-deleted": ["pageIds", "workspaceId"],
      "page-restored": ["pageIds", "workspaceId"],
      "page-deleted": ["pageIds", "workspaceId"],
      "page-moved-to-space": ["pageIds", "spaceId", "workspaceId"],
      "space-deleted": ["spaceId", "workspaceId"],
      "workspace-deleted": ["workspaceId"]
    }
  }
}
