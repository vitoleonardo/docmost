#!/bin/sh
# Apply what /onboard staged, after the user approved the proposal.
# Copies .work/onboard/files/ into the project and .work/onboard/baseline.tsv to .claude/baseline.tsv.
# Claude Code prompts for or refuses writes into .claude/, which is why this is a script the user runs or approves.
# The staged tree names every .claude folder "dot-claude", so the session can write it.
# Usage: .claude/bin/onboard-apply [--dry-run] [--accept-looser]
#   --dry-run        list what would be written, write nothing
#   --accept-looser  write a baseline that is looser than the current one (the user said so)
set -u

root=$(CDPATH='' cd -- "$(dirname -- "$0")/../.." && pwd) || exit 2
cd "$root" || exit 2
stage=.work/onboard
dry=0
looser=0
while [ $# -gt 0 ]; do
  case $1 in
    --dry-run) dry=1 ;;
    --accept-looser) looser=1 ;;
    -h | --help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "onboard-apply: unknown option $1" >&2; exit 2 ;;
  esac
  shift
done
[ -d "$stage/files" ] || [ -f "$stage/baseline.tsv" ] || {
  echo "onboard-apply: nothing staged in $stage/ (run /onboard first)." >&2
  exit 2
}

# The baseline may only get stricter unless the user says otherwise. Check before writing anything.
if [ -f "$stage/baseline.tsv" ] && [ -f .claude/baseline.tsv ]; then
  if ! out=$(.claude/bin/baseline loosened .claude/baseline.tsv "$stage/baseline.tsv"); then
    echo "The new baseline is looser than .claude/baseline.tsv:"
    printf '%s\n' "$out" | sed 's/^/  /'
    if [ "$looser" -eq 0 ]; then
      echo "Nothing written. Fix the cause, or rerun with --accept-looser if the user agrees." >&2
      exit 1
    fi
    echo "Writing it anyway (--accept-looser)."
  fi
fi

written=0
if [ -d "$stage/files" ]; then
  list=$(cd "$stage/files" && find . -type f | sed 's|^\./||' | sort)
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    dest=$(printf '%s\n' "$rel" | sed -e 's|^dot-claude/|.claude/|' -e 's|/dot-claude/|/.claude/|g')
    if [ ! -e "$dest" ]; then
      echo "new      $dest"
    elif cmp -s "$stage/files/$rel" "$dest"; then
      echo "same     $dest"
      continue
    else
      echo "changed  $dest"
      diff -u "$dest" "$stage/files/$rel" | sed -n '3,200p' | sed 's/^/    /'
    fi
    if [ "$dry" -eq 0 ]; then
      mkdir -p "$(dirname -- "$dest")" && cp "$stage/files/$rel" "$dest" || exit 1
      case $dest in */bin/* | .claude/hooks/*) chmod +x "$dest" ;; esac
    fi
    written=$((written + 1))
  done <<EOF
$list
EOF
fi
if [ -f "$stage/baseline.tsv" ] && ! cmp -s "$stage/baseline.tsv" .claude/baseline.tsv 2>/dev/null; then
  echo "baseline .claude/baseline.tsv ($(grep -c . "$stage/baseline.tsv") records)"
  [ "$dry" -eq 1 ] || cp "$stage/baseline.tsv" .claude/baseline.tsv || exit 1
  written=$((written + 1))
fi

if [ "$dry" -eq 1 ]; then
  echo "Dry run: $written file(s) would be written."
else
  echo "Wrote $written file(s). Review them with git diff, then commit."
fi
